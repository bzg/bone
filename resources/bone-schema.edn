;; bone-schema.edn -- Shared schema for bone-digest and bone-export.
;;
;; This file is the union of the email schema (from bone-ingest) and the
;; report/roles schema (from bone-digest).  Both bb scripts read it so
;; they can open the Datalevin DB with the full schema.

{;; --- Email (defined by bone-ingest) ---
 ;; Mailseq id (IMAP UID per folder, Maildir filename per folder).
 ;; Not globally unique -- two sources may collide on UID space or
 ;; Maildir filename across folders.  Dedup is enforced at store time
 ;; as the composite (:email/source, :email/id) pair, not at the
 ;; schema level.
 :email/id                    {:db/valueType :db.type/string}
 :email/source                {:db/valueType :db.type/string}
 ;; Raw Message-Id, kept verbatim for display/export.  NOT unique:
 ;; identity and lookups go through the fixed-length hash below (raw
 ;; mids can exceed LMDB's key limit).
 :email/message-id            {:db/valueType :db.type/string}
 ;; SHA-256 hex of the raw mid (bone.common/mid-hash).
 :email/message-id-hash       {:db/valueType :db.type/string
                               :db/unique    :db.unique/identity}
 :email/subject               {:db/valueType :db.type/string}
 :email/from-name             {:db/valueType :db.type/string}
 :email/from-address          {:db/valueType :db.type/string}
 ;; Reply-To header, raw (kept for traceability when From is munged).
 :email/reply-to-name         {:db/valueType :db.type/string}
 :email/reply-to-address      {:db/valueType :db.type/string}
 ;; Effective author, resolved at source-classification time.
 ;; Equals from-address in the common case; falls back to the first
 ;; reply-to address when the From header is rewritten to the list
 ;; (Mailman/DMARC munging style).  All downstream code (participants,
 ;; commands, roles, reports, exports) reads author-address.
 :email/author-name           {:db/valueType :db.type/string}
 ;; Not indexed: stored verbatim, so value lookups must be
 ;; case-insensitive (bone.digest/open-patch-eids-by-sender compares
 ;; lowercased in a predicate, anchored on the :report/type index).
 :email/author-address        {:db/valueType :db.type/string}
 :email/to                    {:db/valueType   :db.type/string
                               :db/cardinality :db.cardinality/many}
 :email/cc                    {:db/valueType   :db.type/string
                               :db/cardinality :db.cardinality/many}
 :email/date-sent             {:db/valueType :db.type/instant}
 :email/date-received         {:db/valueType :db.type/instant}
 :email/body-text             {:db/valueType :db.type/string}
 :email/body-html             {:db/valueType :db.type/string}
 :email/body-text-from-html   {:db/valueType :db.type/string}
 :email/content-type          {:db/valueType :db.type/string}
 :email/flags                 {:db/valueType   :db.type/keyword
                               :db/cardinality :db.cardinality/many}
 :email/attachments           {:db/valueType   :db.type/ref
                               :db/cardinality :db.cardinality/many
                               :db/isComponent true}
 :attachment/filename         {:db/valueType :db.type/string}
 :attachment/content-type     {:db/valueType :db.type/string}
 :attachment/size             {:db/valueType :db.type/long}
 :attachment/data             {:db/valueType :db.type/string}
 :email/in-reply-to           {:db/valueType :db.type/string}
 :email/references            {:db/valueType :db.type/string}
 ;; Mid-hashes of References + In-Reply-To, one entry per ancestor;
 ;; used by the pending-thread retry.  Ordered raw ancestors are
 ;; recomputed from the headers (digest/ancestor-mids).
 :email/ancestor-mid-hashes   {:db/valueType   :db.type/string
                               :db/cardinality :db.cardinality/many}
 ;; Set when an email is ingested while its In-Reply-To target is
 ;; absent from the DB.  Phase 3/4 of process-email! is skipped on
 ;; pending emails; they are retried when a related email arrives or
 ;; when a TTL job forces the threading.
 :email/pending-thread?       {:db/valueType :db.type/boolean}
 :email/headers-edn           {:db/valueType :db.type/string}
 :email/ingested-at           {:db/valueType :db.type/instant}
 :email/digested-at           {:db/valueType :db.type/instant}
 :watermark/id                {:db/valueType :db.type/string
                               :db/unique    :db.unique/identity}
 :watermark/imap-uid          {:db/valueType :db.type/long}
 ;; UIDVALIDITY (RFC 3501) captured when the UID watermark was last
 ;; advanced. If the server's current UIDVALIDITY no longer matches,
 ;; the stored UID is meaningless (mailbox recreation, server migration)
 ;; and the watermark is reset to 0 to trigger a full first-run re-fetch.
 ;; IMAP-only -- Maildir relies on :watermark/seen-ids instead.
 :watermark/imap-uid-validity {:db/valueType :db.type/long}
 :watermark/seen-ids          {:db/valueType   :db.type/string
                               :db/cardinality :db.cardinality/many}
 :watermark/maildir-init      {:db/valueType :db.type/boolean}

 ;; --- Reports (defined by bone-digest) ---
 ;;
 ;; Every "state" attribute is a ref to the email that posed it.
 ;; The setter's address is available either via the ref (follow it
 ;; to :email/author-address) or, for proxy-capable state attrs, via
 ;; the cached `-address` attr below -- which may diverge from the
 ;; email's author-address when a maintainer uses the `-by` form.
 ;; Indexed: every "open reports of type X" query (auto-supersede,
 ;; series, release :change closing, ...) filters by exact value.
 :report/type                  {:db/valueType :db.type/keyword
                                :db/index     true}
 :report/email                 {:db/valueType :db.type/ref}
 ;; Raw root Message-Id, kept verbatim for display/export; identity
 ;; and lookups go through the hash (as for :email/message-id).
 :report/message-id            {:db/valueType :db.type/string}
 :report/message-id-hash       {:db/valueType :db.type/string
                                :db/unique    :db.unique/identity}
 :report/version               {:db/valueType :db.type/string}
 :report/patch-seq             {:db/valueType :db.type/string}
 :report/patch-source          {:db/valueType   :db.type/keyword
                                :db/cardinality :db.cardinality/many}
 :report/descendants           {:db/valueType   :db.type/ref
                                :db/cardinality :db.cardinality/many}
 ;; State attributes -- ref to the email that posed the state.
 ;; Paired with `-address` for the proxy-capable ones (see below).
 :report/acked                 {:db/valueType :db.type/ref}
 :report/owned                 {:db/valueType :db.type/ref}
 :report/closed                {:db/valueType :db.type/ref}
 :report/urgent                {:db/valueType :db.type/ref}
 :report/important             {:db/valueType :db.type/ref}
 ;; Address of the person designated by the command (same as email's author-address
 ;; for direct triggers, may differ for -by directives).
 ;; Present only for state attrs that support the `-by` proxy form.
 :report/acked-address         {:db/valueType :db.type/string}
 :report/owned-address         {:db/valueType :db.type/string}
 :report/closed-address        {:db/valueType :db.type/string}
 :report/urgent-address        {:db/valueType :db.type/string}
 :report/important-address     {:db/valueType :db.type/string}
 ;; Why the report was closed: :resolved, :cancelled, :expired, or :superseded
 :report/close-reason          {:db/valueType :db.type/keyword}
 ;; Topic, deadline, expiry: the ref points to the email that posed
 ;; the value.  The actual business value lives in the paired `-value`
 ;; scalar attr.  These commands have no proxy form, so there is no
 ;; `-address` attr.
 ;; (Superseded-by has moved to the qualified-relations layer below;
 ;; see :rel/* attributes.)
 :report/topic                 {:db/valueType :db.type/ref}
 :report/topic-value           {:db/valueType :db.type/string}
 :report/deadline              {:db/valueType :db.type/ref}
 :report/deadline-value        {:db/valueType :db.type/instant}
 :report/expiry                {:db/valueType :db.type/ref}
 :report/expiry-value          {:db/valueType :db.type/instant}
 :report/last-activity         {:db/valueType :db.type/instant}
 :report/last-activity-address {:db/valueType :db.type/string}
 :report/has-ics               {:db/valueType :db.type/boolean}
 :report/has-text-attachments  {:db/valueType :db.type/boolean}
 ;; Git person trailers (Acked-by:, Reviewed-by:, ...) collected from
 ;; replies to a patch report, verbatim "Key: Name <addr>" strings.
 ;; Clients applying the patch fold them into the commit message
 ;; (b4-style).  Set semantics: duplicates and replays collapse.
 :report/trailers              {:db/valueType   :db.type/string
                                :db/cardinality :db.cardinality/many}
 :report/updated-at            {:db/valueType :db.type/instant}
 ;; Wall-clock instant the report was first created (ingested), as opposed
 ;; to the originating email's date (`:report/email` -> :email/date-sent),
 ;; which can be back- or future-dated.  Lets the cron notification count
 ;; genuine additions reliably, regardless of the email's Date header.
 :report/created-at            {:db/valueType :db.type/instant}
 ;; Like :report/updated-at but bumped only on *effective* changes to the
 ;; report itself (status, flags, relations, expiry, ...), never on mere
 ;; thread growth (a reply attached as a descendant).  Lets the cron
 ;; notification tell genuine report modifications from contextual noise.
 :report/state-changed-at      {:db/valueType :db.type/instant}

 ;; --- Global metadata (export change tracking) ---
 :meta/ident         {:db/valueType :db.type/string
                      :db/unique    :db.unique/identity}
 :meta/last-modified {:db/valueType :db.type/instant}

 ;; --- Votes (one entity per voter per report) ---
 :vote/key    {:db/valueType :db.type/string
               :db/unique    :db.unique/identity}  ;; "report-mid-hash:voter-addr"
 :vote/report {:db/valueType :db.type/ref}
 :vote/email  {:db/valueType :db.type/ref}
 :vote/value  {:db/valueType :db.type/keyword}     ;; :up :down :null
 :vote/voter  {:db/valueType :db.type/string}

 :report/series  {:db/valueType :db.type/ref}
 :report/patches {:db/valueType   :db.type/ref
                  :db/cardinality :db.cardinality/many
                  :db/isComponent true}

 ;; --- Qualified relations between reports (defined by bone.relations) ---
 ;;
 ;; A relation is a standalone entity linking two reports.  Asymmetric
 ;; kinds (:resolves, :supersedes, :duplicates) are stored as TWO
 ;; entities (one per direction); the symmetric kind :related-to is
 ;; stored as ONE entity canonicalized by ascending eid order.
 ;;
 ;; :rel/id encodes <from-eid>:<kind>:<to-eid> for replay idempotence.
 ;; :rel/active? is flipped to false on retract; the entity is kept
 ;; for audit instead of being physically retracted.  A re-pose dated
 ;; after the retraction flips it back (see pose-if-absent!).
 :rel/id           {:db/valueType :db.type/string
                    :db/unique    :db.unique/identity}
 :rel/from         {:db/valueType :db.type/ref}
 :rel/to           {:db/valueType :db.type/ref}
 ;; Indexed: :rel is the highest-cardinality entity, and nearly every
 ;; bone.relations query filters by a bound :rel/kind.  (Not :rel/active?:
 ;; a boolean is barely more selective than a scan -- :rel/kind carries
 ;; the selectivity, :rel/active? is a cheap post-filter.)
 :rel/kind         {:db/valueType :db.type/keyword
                    :db/index     true}
 :rel/setter       {:db/valueType :db.type/string}
 :rel/email        {:db/valueType :db.type/ref}
 :rel/posed-at     {:db/valueType :db.type/instant}
 :rel/value        {:db/valueType :db.type/string}
 :rel/active?      {:db/valueType :db.type/boolean}
 :rel/retracted-by {:db/valueType :db.type/ref}

 ;; --- Patch content entities ---
 :patch/filename {:db/valueType :db.type/string}
 :patch/source   {:db/valueType :db.type/keyword}
 :patch/text     {:db/valueType :db.type/string}
 :patch/author   {:db/valueType :db.type/string}
 :patch/subject  {:db/valueType :db.type/string}
 :patch/date     {:db/valueType :db.type/string}

 ;; --- Patch series ---
 :series/id           {:db/valueType :db.type/string
                       :db/unique    :db.unique/identity}
 ;; Two independent AVET indexes (not a composite): every series
 ;; lookup binds both values, either index narrows the scan.
 :series/topic        {:db/valueType :db.type/string
                       :db/index     true}
 :series/sender       {:db/valueType :db.type/string
                       :db/index     true}
 :series/expected     {:db/valueType :db.type/long}
 :series/cover-letter {:db/valueType :db.type/ref}
 :series/patches      {:db/valueType   :db.type/ref
                       :db/cardinality :db.cardinality/many}
 :series/closed       {:db/valueType :db.type/ref}

 ;; --- Participants (anyone who creates a report or applies a command) ---
 :participant/key               {:db/valueType :db.type/string
                                 :db/unique    :db.unique/identity}  ;; "source:email"
 :participant/source            {:db/valueType :db.type/string}
 :participant/email             {:db/valueType :db.type/string}
 :participant/name              {:db/valueType :db.type/string}
 :participant/since             {:db/valueType :db.type/instant}
 :participant/contributor-since {:db/valueType :db.type/instant}  ;; non-nil = submitted code

 ;; --- Per-source maintainer tenures ---
 ;; Each entity represents one contiguous period during which a given
 ;; address held maintainer status on a given source. Multiple tenures
 ;; can exist for the same (source, email) if a maintainer was removed
 ;; and re-added over time.
 ;;
 ;; :maint-tenure/from absent = active since the beginning of time
 ;;   (used for tenures seeded from a source without :periods, or from
 ;;   the first :periods entry that omits :start).
 ;; :maint-tenure/to   absent = tenure is currently active.
 ;; :maint-tenure/order encodes the index within a period's :maintainers
 ;;   vector at the time the tenure was opened (used only as a tie-break
 ;;   when computing the lead maintainer). Absent for tenures opened at
 ;;   runtime via "Add maintainer:" directives.
 ;;
 ;; Config :periods sync at each boundary:
 ;;   - declared maintainers missing at the boundary are opened with
 ;;     :from = period :start (nil for the first unbounded-past period);
 ;;   - active tenures absent from the declared list are closed with
 ;;     :to = period :start (skipped with a warning when :start is nil).
 ;;
 ;; The "lead maintainer" for a source is the currently-active tenure
 ;; (no :to) with the earliest :from (absent sorts first), tie-broken
 ;; by :order, then by email lexicographic order. The lead is the only
 ;; one allowed to remove maintainers and cannot remove themselves.
 :maint-tenure/source {:db/valueType :db.type/string}
 :maint-tenure/email  {:db/valueType :db.type/string}
 :maint-tenure/from   {:db/valueType :db.type/instant}
 :maint-tenure/to     {:db/valueType :db.type/instant}
 :maint-tenure/order  {:db/valueType :db.type/long}}
